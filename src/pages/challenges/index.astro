---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import CatalogCard from '~/components/catalog/CatalogCard.astro';
import { fetchCatalogItems } from '~/utils/catalog';

const items = await fetchCatalogItems();
const languages = Array.from(new Set(items.flatMap((item) => item.languages))).sort();
const topics = Array.from(new Set(items.flatMap((item) => item.topics))).sort();

const metadata = {
  title: 'Challenges catalog',
  description: 'All challenge subjects discovered from Markdown files under challenges/.',
};
---

<Layout metadata={metadata}>
  <section class="border-b border-slate-200 bg-white py-14 dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-700 dark:bg-emerald-950 dark:text-emerald-200">
          <Icon name="tabler:list-details" class="h-4 w-4" />
          Subject-backed catalog
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl">Challenges catalog</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Each entry is generated from a Markdown subject under `challenges/`. Source code stays next to the subject,
          and extracted PDF subjects link back to the original PDF file.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-10 dark:bg-slate-900/60">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:px-8">
      <aside class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-950">
        <h2 class="text-sm font-semibold uppercase tracking-normal text-slate-500 dark:text-slate-400">Facets</h2>
        <div class="mt-5">
          <h3 class="font-semibold text-slate-950 dark:text-white">Languages</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {languages.map((language) => <span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-200">{language}</span>)}
          </div>
        </div>
        <div class="mt-6">
          <h3 class="font-semibold text-slate-950 dark:text-white">Topics</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {topics.map((topic) => <span class="rounded-full bg-amber-50 px-3 py-1 text-xs text-amber-700 dark:bg-amber-950 dark:text-amber-200">{topic}</span>)}
          </div>
        </div>
      </aside>

      <div class="grid gap-5 md:grid-cols-2">
        {items.map((item) => <CatalogCard item={item} />)}
      </div>
    </div>
  </section>
</Layout>
