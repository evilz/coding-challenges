---
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { getCatalogItemFromEntry, getCatalogPages } from '~/utils/catalog';
import type { CatalogPage } from '~/utils/catalog';
import { cleanSlug, getPermalink } from '~/utils/permalinks';

export async function getStaticPaths() {
  const pages = await getCatalogPages();

  return pages.map((page) => ({
    params: { slug: page.item.slug },
    props: { page },
  }));
}

interface Props {
  page: CatalogPage;
}

const { page } = Astro.props as Props;
const item = page.item;
const isGroupedPage = page.type === 'group';
const { Content } = isGroupedPage ? { Content: undefined } : await render(page.entry);
const groupedSections = isGroupedPage
  ? await Promise.all(
      page.entries.map(async (entry, index) => {
        const { Content: SectionContent } = await render(entry);
        const sectionItem = await getCatalogItemFromEntry(entry);

        return {
          sectionItem,
          SectionContent,
          sectionId: `${index + 1}-${cleanSlug(sectionItem.title) || sectionItem.slug.split('/').at(-1) || `section-${index + 1}`}`,
        };
      })
    )
  : [];

const metadata = {
  title: item.title,
  description: item.summary,
};
---

<Layout metadata={metadata}>
  <article class="bg-white dark:bg-slate-950">
    <header class="border-b border-slate-200 dark:border-slate-800">
      <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
        <a class="inline-flex items-center gap-2 text-sm font-semibold text-blue-700 hover:underline dark:text-blue-300" href={getPermalink('/challenges')}>
          <Icon name="tabler:arrow-left" class="h-4 w-4" />
          Back to catalog
        </a>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl">{item.title}</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">{item.summary}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button variant="primary" href={item.repositoryUrl} target="_blank" text="Open code folder" icon="tabler:folder-code" />
          <Button href={item.documentUrl} target="_blank" text="Source markdown" icon="tabler:file-text" />
          {item.pdfUrl && <Button href={item.pdfUrl} target="_blank" text="Original PDF" icon="tabler:file-type-pdf" />}
          {
            item.sourceUrl && (
              <Button href={item.sourceUrl} target="_blank" text="Source repository" icon="tabler:brand-github" />
            )
          }
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:px-8">
      <div class="prose prose-slate max-w-none dark:prose-invert">
        {
          isGroupedPage ? (
            <>
              <nav class="not-prose mb-10 rounded-lg border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900">
                <h2 class="text-sm font-semibold uppercase tracking-normal text-slate-500 dark:text-slate-400">Subjects</h2>
                <ol class="mt-4 list-decimal space-y-2 pl-5">
                  {groupedSections.map(({ sectionId, sectionItem }) => (
                    <li>
                      <a class="font-medium text-blue-700 hover:underline dark:text-blue-300" href={`#${sectionId}`}>
                        {sectionItem.title}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
              {groupedSections.map(({ sectionId, sectionItem, SectionContent }) => (
                <section id={sectionId} class="mb-14 scroll-mt-24">
                  <h2>{sectionItem.title}</h2>
                  <div class="not-prose mt-3 flex flex-wrap gap-2">
                    <Button href={sectionItem.documentUrl} target="_blank" text="Source markdown" icon="tabler:file-text" />
                    {sectionItem.pdfUrl && <Button href={sectionItem.pdfUrl} target="_blank" text="Original PDF" icon="tabler:file-type-pdf" />}
                    {sectionItem.sourceUrl && <Button href={sectionItem.sourceUrl} target="_blank" text="Source repository" icon="tabler:brand-github" />}
                  </div>
                  <div class="mt-6">
                    <SectionContent />
                  </div>
                </section>
              ))}
            </>
          ) : (
            Content && <Content />
          )
        }
      </div>

      <aside class="h-fit rounded-lg border border-slate-200 p-5 dark:border-slate-800">
        <h2 class="text-sm font-semibold uppercase tracking-normal text-slate-500 dark:text-slate-400">Metadata</h2>
        <dl class="mt-5 grid gap-4 text-sm">
          <div>
            <dt class="text-slate-500 dark:text-slate-400">Type</dt>
            <dd class="mt-1 font-medium capitalize text-slate-950 dark:text-white">{isGroupedPage ? 'group' : item.documentType}</dd>
          </div>
          {isGroupedPage && (
            <div>
              <dt class="text-slate-500 dark:text-slate-400">Subjects</dt>
              <dd class="mt-1 font-medium text-slate-950 dark:text-white">{groupedSections.length}</dd>
            </div>
          )}
          <div>
            <dt class="text-slate-500 dark:text-slate-400">Document</dt>
            <dd class="mt-1 font-mono text-xs font-medium text-slate-950 dark:text-white">{item.documentPath}</dd>
          </div>
          <div>
            <dt class="text-slate-500 dark:text-slate-400">Folder</dt>
            <dd class="mt-1 font-mono text-xs font-medium text-slate-950 dark:text-white">{item.repositoryPath}</dd>
          </div>
          <div>
            <dt class="text-slate-500 dark:text-slate-400">Languages</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {item.languages.map((language) => <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-200">{language}</span>)}
            </dd>
          </div>
          <div>
            <dt class="text-slate-500 dark:text-slate-400">Topics</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {item.topics.map((topic) => <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-medium text-amber-700 dark:bg-amber-950 dark:text-amber-200">{topic}</span>)}
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </article>
</Layout>
